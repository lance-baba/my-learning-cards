{
  "name": "cardflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "preview": "node local-server.js",
    "build:css": "tailwindcss -i tools/tailwind-input.css -o public/vendor/tailwind.min.css --minify",
    "audit:css": "node tools/audit_css_classes.js",
    "validate": "node tools/card_tool.js validate",
    "test": "node tools/observe.test.mjs && node tools/cardflow-logic.test.mjs && node tools/ratelimit.test.mjs && node tools/sync_kv.test.mjs && node tools/sw_cache.test.mjs",
    "test:unit": "node tools/cardflow-logic.test.mjs && node tools/ratelimit.test.mjs && node tools/sync_kv.test.mjs && node tools/sw_cache.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "new": "node tools/card_tool.js new",
    "setup-kv": "node tools/setup_kv.js",
    "sync": "node tools/sync_kv.js",
    "sync:check": "node tools/sync_kv.js --check",
    "sync:verify": "node tools/sync_kv.js --verify",
    "login": "wrangler login"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "2.2.19",
    "wrangler": "^4.0.0"
  }
}
