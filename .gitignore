# 依赖
node_modules/

# Wrangler 本地状态 / 构建产物
.wrangler/
.mf/
dist/

# npm 缓存与日志
.npmcache/
.npm-cache/
install.log
npm-debug.log*
npm_install*.log

# 本地预览截图（非源码资产）
_preview_*.png

# 一次性回滚备份：改造前的 2.80MB 全量 Tailwind。
# 不入库（2.8MB 死重且永不变更）；回滚直接用 git revert 即可，
# 或按需重建：npx tailwindcss@2.2.19 build -o tailwind.full.backup.css
public/vendor/tailwind.full.backup.css

# 临时脚本工作区
tools/tmp/

# 系统 / 编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 环境变量（若后续引入密钥）
.env
.env.*

# Wrangler 本地密钥（dev 模式读取，等价于云端的 secret，绝不能入库）
.dev.vars
.dev.vars.*

# 题库发布本地清单（每次 publish/upload 都会追加，属运行时状态，不入库）
codes_manifest.json

# make_bank.py 生成的题库 JSON（发布进 KV 即为最终产物，本地文件属运行时产物）
generated_banks/

# 注意：data/ 与 public/vendor/ 必须入库
#   - data/ 是题库唯一权威副本
#   - public/vendor/ 是自托管依赖，缺了部署即白屏
