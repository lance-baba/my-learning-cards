    {
      "id": "agriculture_topic_柑橘",
      "title": "柑橘",
      "tags": [
        "水果",
        "芸香科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "柑橘有什么营养？",
          "content": "柑橘是芸香科柑橘属各种水果统称，富含维生素C；主要源头物种包括柚、枸橼、橘、柑、金柑等。",
          "citation_anchor": "富含维C",
          "action_hint": "冬季主力水果。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "柑橘的起源",
          "front_text": "从哪来？",
          "back_text": "基因组学显示柑橘属起源与早期分化可能发生于南亚至东亚交界（如喜马拉雅东南麓、中国西南—华南）；今日多数商业柑橘由祖源杂交形成。",
          "citation_anchor": "中国西南起源",
          "action_hint": "翻面看演化。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "柑橘要点",
          "streaming_content": "① 学名 Citrus，芸香科。\n② 世界产量最大水果，年超一亿吨。\n③ 巴西、中国、美国产量最多。",
          "citation_anchor": "产量最大水果",
          "action_hint": "酸甜大宗。"
        }
      ],
      "source": {
        "name": "百度百科",
