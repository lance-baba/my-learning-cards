        "authority_level": "encyclopedia"
      }
    },
    {
      "id": "agriculture_topic_农药",
      "title": "农药",
      "tags": [
        "植保",
        "风险"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "农药分几类？",
          "content": "农药依使用对象分杀菌剂、杀真菌剂、除草剂、杀虫剂（有机氯/有机磷等）、杀螨剂、杀线虫剂、杀鼠剂等；用于保护农作物。",
          "citation_anchor": "按对象分类",
          "action_hint": "不含肥料与兽药。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "农药的风险",
          "front_text": "滥用会怎样？",
          "back_text": "未守停药期或滥用禁药会造成残留带毒；污染河湖致鱼蛙死亡、富营养化；DDT等威胁生物多样性。",
          "citation_anchor": "残留与污染",
          "action_hint": "翻面看风险。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "科学用药",
          "streaming_content": "① 1939年DDT等大幅增效，1950来用量增约50倍。\n② 各地有残留限量规范。\n③ 需合理使用、控残留。",
          "citation_anchor": "合理用药",
          "action_hint": "保产亦保安全。"
        },
        {
          "sub_id": "s_en_list",
          "layout": "list_card",
          "title": "核心要点",
          "items": [
            "定义：防除病虫草鼠等有害生物、调节生长的化学制剂总称。",
            "分类：杀虫剂、杀菌剂、除草剂、植物生长调节剂。",
            "原则：对症、适时、适量，严格按标签与安全间隔期。",
            "防护：施药穿戴防护、避逆风、远离蜂群与水源。",
            "风险：滥用致残留超标、抗药性与环境污染。"
          ]
        },
        {
          "sub_id": "s_en_quote",
          "layout": "quote_card",
          "title": "权威摘录",
          "quote": "农药的滥用会带来农产品残留超标、有害生物抗药性增强以及生态环境污染等问题。",
          "citation": "概述"
        },
        {
          "sub_id": "s_en_cmp",
          "layout": "compare_card",
          "title": "常见误区",
          "wrong": "农药浓度调高一点、多打几次，杀虫更彻底。",
          "right": "严格按标签推荐剂量与频次；随意加量易生药害、残留超标，并加速害虫抗药性。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "农药",
        "url": "https://baike.baidu.com/item/%E5%86%9C%E8%8D%AF",
        "publish_date": "",
        "authority_level": "encyclopedia"
      },
      "difficulty": 2
    },
    {
      "id": "agriculture_topic_轮作",
      "title": "轮作",
      "tags": [
        "耕作制度",
        "养地"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "轮作是什么？",
          "content": "轮作指同一块土地轮流种植不同作物，以助减少土壤侵蚀、保持地力及增加产量，避免连作缺点。",
          "citation_anchor": "轮流种植",
          "action_hint": "古老智慧。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "轮作为什么好？",
          "front_text": "双重好处？",
          "back_text": "害虫只侵特定植物，轮作可中止其周期减少虫患；不同作物养分需求不同，豆科可固氮补肥平衡地力。",
          "citation_anchor": "打断病虫害",
          "action_hint": "翻面看机理。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "轮作要点",
          "streaming_content": "① 常配合休耕、绿肥或豆谷复种。\n② 减少连作导致的地力耗损。\n③ 中国废休耕用复种套种。",
          "citation_anchor": "绿肥配合",
          "action_hint": "用地养地结合。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "轮作",
        "url": "https://baike.baidu.com/item/%E8%BD%AE%E4%BD%9C",
        "publish_date": "",
        "authority_level": "encyclopedia"
      }
    },
    {
      "id": "agriculture_topic_滴灌",
      "title": "滴灌",
      "tags": [
        "节水灌溉",
        "精准"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "滴灌怎么节水？",
          "content": "滴灌将水和肥料一滴一滴输送到植物根部，可最大限度利用有限水资源、降低水肥损失、减少蒸腾浪费、均匀度高。",
          "citation_anchor": "根部供给",
          "action_hint": "以色列 pioneered。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "滴灌适用哪？",
          "front_text": "哪些地方最受益？",
          "back_text": "特别适用于急性缺水地区（如椰子、葡萄、棉花等作物）；出水口间距多为10–75cm；为种植者提供准确控制模式。",
          "citation_anchor": "干旱区适用",
          "action_hint": "翻面看场景。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "滴灌意义",
          "streaming_content": "① 由以色列人员研究开发并大量应用。\n② 科学满足作物水肥需要。\n③ 水资源极度紧张时的优选。",
          "citation_anchor": "以方开发",
          "action_hint": "精准农业一环。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "滴灌",
        "url": "https://baike.baidu.com/item/%E6%BB%B4%E7%81%8C",
        "publish_date": "",
        "authority_level": "encyclopedia"
      }
    },
    {
      "id": "agriculture_topic_番薯",
      "title": "番薯",
      "tags": [
        "粮食作物",
        "旋花科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "番薯有什么营养？",
          "content": "番薯（学名 Ipomoea batatas）地下块根硕大味甜、富含淀粉，是世界主要主食作物之一；红心番薯富含β-胡萝卜素（可转化维生素A）。",
          "citation_anchor": "β-胡萝卜素",
          "action_hint": "缓解维生素A缺乏。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "番薯的来历",
          "front_text": "从哪来？",
          "back_text": "原产南美洲热带地区，经哥伦布大交换传播至全球；对土壤适应强、耐瘠薄，历史上常救荒保粮食安全。",
          "citation_anchor": "哥伦布大交换",
          "action_hint": "翻面看传播。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "番薯要点",
          "streaming_content": "① 旋花科番薯属一年生或多年生。\n② 块根作主食。\n③ 发展中国家重要作物。",
          "citation_anchor": "耐瘠薄",
          "action_hint": "救命作物。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "番薯",
        "url": "https://baike.baidu.com/item/%E7%95%AA%E8%96%AF",
