  "items": [
    {
      "id": "agri_topic_001",
      "title": "小麦赤霉病综合防治指南",
      "tags": [
        "病虫害",
        "小麦"
      ],
      "type": "knowledge",
      "source": {
        "name": "全国农业技术推广服务中心",
        "title": "2026年全国小麦重大病虫害防控总体方案",
        "url": "http://www.natesc.org.cn/",
        "publish_date": "2026-01-15",
        "authority_level": "official"
      },
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "如何抓准小麦赤霉病的最佳防治窗口期？",
          "content": "赤霉病是小麦爆发性病害，防重于治。一旦错过发病前预防期，后期喷药效果大幅衰减。",
          "action_hint": "左右滑动查看防治三步法 ➔",
          "citation_anchor": "第一章第2条"
        },
        {
          "sub_id": "s2",
          "layout": "streaming_text",
          "title": "第一步：精准判定防治时期",
          "streaming_content": "最佳时期：小麦齐穗至扬花初始期（见花打药）。若遇连续阴雨，需在扬花期前预防喷药。",
          "citation_anchor": "第一章第3条"
        },
        {
          "sub_id": "s3",
          "layout": "flip_card",
          "title": "推荐用药组合（点击翻转）",
          "front_text": "你知道抗性最低的复配药剂是什么吗？",
          "back_text": "推荐选用：丙硫菌唑 + 戊唑醇，或 氰烯菌酯 + 戊唑醇。",
          "citation_anchor": "第二章第1条"
        }
      ]
    },
    {
      "id": "agriculture_topic_水稻",
      "title": "水稻",
      "tags": [
        "粮食作物",
        "禾本科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "水稻是什么？",
          "content": "水稻（学名 Oryza sativa）是禾本科稻属的一至二年生草本植物，其果实称米，全世界有半数以上人口以水稻为主食。",
          "citation_anchor": "半数人口主食",
          "action_hint": "为何亚洲是主产区？"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "水稻的起源",
          "front_text": "水稻从哪来？",
          "back_text": "野生稻约8500年前在长江中下游驯化为粳稻，后传至印度转为籼稻，属亚洲起源；喜温湿、耐水，多种于水田。",
          "citation_anchor": "长江中下游驯化",
          "action_hint": "翻面看驯化史。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "种植要点",
          "streaming_content": "① 不耐低温，最适生长温度25~30°C。\n② 年雨量1200毫米以上或具灌溉设施地区可栽培。\n③ 熟分乳熟、黄熟（机收适期）、完熟（人收适期）、枯熟四阶段。",
          "citation_anchor": "四熟期",
          "action_hint": "水田管理的核心。"
        },
        {
          "sub_id": "s_en_list",
          "layout": "list_card",
          "title": "核心要点",
          "items": [
            "地位：全球约半数人口的主粮，三大谷物之一。",
            "起源：亚洲栽培稻最早在中国长江中下游驯化（上山文化稻作证据）。",
            "习性：喜温喜湿，全生育期需稳定水层与光热。",
            "关键期：分蘖、幼穗分化、抽穗灌浆对水肥最敏感。",
            "类型：籼稻、粳稻、糯稻等。"
          ]
        },
        {
          "sub_id": "s_en_quote",
          "layout": "quote_card",
          "title": "权威摘录",
          "quote": "水稻是世界上最重要的粮食作物之一，养活了全球约一半的人口。",
          "citation": "概述"
        },
        {
          "sub_id": "s_en_cmp",
          "layout": "compare_card",
          "title": "常见误区",
          "wrong": "水稻田水越深越长得好。",
          "right": "分蘖期宜浅水勤灌、适时排水晾田；长期深水致僵苗、纹枯病加重，产量反降。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "水稻",
        "url": "https://baike.baidu.com/item/%E6%B0%B4%E7%A8%BB",
        "publish_date": "",
        "authority_level": "encyclopedia"
      },
      "difficulty": 2
    },
    {
      "id": "agriculture_topic_小麦",
      "title": "小麦",
      "tags": [
        "粮食作物",
        "禾本科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "小麦为什么能做面包？",
          "content": "小麦籽粒蛋白质含麦谷蛋白和醇溶蛋白，赋予面团黏弹性，是制作面包等面食的主要原料；普通小麦占全球产量约95%。",
          "citation_anchor": "面筋蛋白",
          "action_hint": "其他谷物为何不行？"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "小麦的栽培类型",
          "front_text": "冬麦与春麦？",
          "back_text": "栽培分冬小麦（耐寒、利用夏前成熟）与春小麦；最早约1.28万年前在西亚新月沃地被驯化，后传播至全球温带与亚热带。",
          "citation_anchor": "新月沃地驯化",
          "action_hint": "翻面看传播史。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "小麦的意义",
          "streaming_content": "① 全球超三分之一人口的主要食粮。\n② 中国第二大口粮作物，仅次于水稻。\n③ 支撑食品加工与牲畜饲料。",
          "citation_anchor": "第二大口粮",
          "action_hint": "主粮安全的基石。"
        },
        {
          "sub_id": "s_en2_list",
          "layout": "list_card",
          "title": "核心要点",
          "items": [
            "小麦（Triticum）是禾本科一年生或越年生作物，与水稻、玉米并称世界三大主粮。",
            "籽粒磨粉成面粉，是面包、面条、馒头等主食的主要原料。",
            "按播种季分冬小麦与春小麦；按质地分硬粒小麦与软粒小麦。",
            "面粉能形成面筋（谷蛋白），因此适合做面包、馒头，而不适合替代蛋糕用低筋粉。",
            "中国是世界主要小麦生产国之一，主产区集中在黄淮海平原。"
          ]
        },
        {
          "sub_id": "s_en2_compare",
          "layout": "compare_card",
          "title": "常见误区",
          "wrong": "全麦面包和普通白面包营养差不多，只是颜色深一点。",
          "right": "全麦保留麸皮与胚芽，膳食纤维、B 族维生素和矿物质显著高于精白面粉；单看颜色深不等于全麦。"
        },
        {
          "sub_id": "s_en2_quote",
          "layout": "quote_card",
          "title": "权威摘录",
          "quote": "小麦与水稻、玉米并称为世界三大主粮，是全球数十亿人口主食的能量来源之一。",
          "citation": "概述"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "小麦",
        "url": "https://baike.baidu.com/item/%E5%B0%8F%E9%BA%A6",
        "publish_date": "",
        "authority_level": "encyclopedia"
      },
      "difficulty": 2
    },
    {
      "id": "agriculture_topic_大豆",
      "title": "大豆",
      "tags": [
        "油料作物",
        "豆科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "大豆为何能肥田？",
          "content": "大豆根部与根瘤菌共生可固氮，是“田里的肉”——蛋白质含量高，为素食者优质蛋白首选，也是全球重要饲料蛋白来源。",
          "citation_anchor": "根瘤菌固氮",
          "action_hint": "豆科为何特殊？"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "大豆的用途",
          "front_text": "大豆能做成什么？",
          "back_text": "种子富含蛋白质与脂肪，可制大豆油、豆粕；也是豆腐、酱油、味噌等豆制品及调味品原料。原产中国，约5000年栽培史。",
          "citation_anchor": "豆腐酱油原料",
          "action_hint": "翻面看加工链。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "大豆要点",
          "streaming_content": "① 学名 Glycine max，古称“菽”。\n② 新石器时代遗址已有残留物。\n③ 兼作含油种子与豆类蛋白来源。",
          "citation_anchor": "5000年栽培",
          "action_hint": "东方传统作物。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "大豆",
        "url": "https://baike.baidu.com/item/%E5%A4%A7%E8%B1%86",
        "publish_date": "",
        "authority_level": "encyclopedia"
      }
    },
    {
      "id": "agriculture_topic_番茄",
      "title": "番茄",
      "tags": [
        "蔬菜",
        "茄科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "番茄是蔬菜还是水果？",
          "content": "番茄（学名 Solanum lycopersicum）原产中美洲和南美洲；大番茄定义为蔬菜，小番茄（圣女果）为水果，美国最高法院曾判其为蔬菜。",
          "citation_anchor": "蔬果之争",
          "action_hint": " botanically 是果实。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "番茄的营养",
          "front_text": "番茄好在哪？",
          "back_text": "红色番茄富含维生素C（14mg/100g）与番茄红素（2573µg/100g）；2019年全球产量1.81亿吨，中国居首。",
          "citation_anchor": "番茄红素",
          "action_hint": "翻面看营养数据。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "番茄要点",
          "streaming_content": "① 林奈1753年命名，与马铃薯同属茄科。\n② 最早栽培记录可溯公元前500年。\n③ 是茄科开花植物模型生物之一。",
          "citation_anchor": "模型生物",
          "action_hint": "家常却重要。"
        },
        {
          "sub_id": "s_en2_list",
          "layout": "list_card",
          "title": "核心要点",
          "items": [
            "番茄（Solanum lycopersicum）原产南美洲，茄科一年生蔬菜。",
            "植物学上属浆果（果实），日常烹饪中常作蔬菜使用。",
            "富含维生素 C 与番茄红素（脂溶性抗氧化物质，熟吃更易吸收）。",
            "喜温不耐寒，适宜生长温度约 20–25℃。",
            "既是生鲜蔬菜，也是番茄酱、汁、罐头等加工品的重要原料。"
          ]
        },
        {
          "sub_id": "s_en2_compare",
          "layout": "compare_card",
          "title": "常见误区",
          "wrong": "番茄是蔬菜，所以它不是水果。",
          "right": "植物学上番茄是果实（浆果）；因常被烹调用，日常与法律上多归为蔬菜（如美国 1893 年关税案裁定）。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "番茄",
        "url": "https://baike.baidu.com/item/%E7%95%AA%E8%8C%84",
        "publish_date": "",
        "authority_level": "encyclopedia"
      },
      "difficulty": 1
    },
    {
      "id": "agriculture_topic_苹果",
      "title": "苹果",
      "tags": [
        "水果",
        "蔷薇科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "苹果从哪里来？",
          "content": "苹果（学名 Malus domestica）起源于中亚，野生祖先为新疆野苹果，沿丝绸之路传播至欧洲等地；已知超过7500个品种。",
          "citation_anchor": "新疆野苹果",
          "action_hint": "丝绸之路带去的。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "苹果的产业",
          "front_text": "苹果产量多大？",
          "back_text": "2017年全球苹果产量8310万公吨，中国占总产量一半，为温带广泛种植果树；平安夜作为“平安果”成文化象征。",
          "citation_anchor": "中国占一半",
          "action_hint": "翻面看产业数据。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "苹果要点",
          "streaming_content": "① 蔷薇科苹果属落叶乔木。\n② 富含营养，有“一天一苹果，医生远离我”之说。\n③ 多国文化具宗教与神话意义。",
          "citation_anchor": "一日一苹果",
          "action_hint": "最常见的水果之一。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "苹果",
        "url": "https://baike.baidu.com/item/%E8%8B%B9%E6%9E%9C",
