        "publish_date": "",
        "authority_level": "encyclopedia"
      }
    },
    {
      "id": "agriculture_topic_花生",
      "title": "花生",
      "tags": [
        "油料作物",
        "豆科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "花生为什么叫落花生？",
          "content": "花生（Arachis hypogaea）地上开花、受粉后子房柄入土发育荚果（地下结果），故有“落花生”之称；原产南美洲。",
          "citation_anchor": "地下结果",
          "action_hint": "豆科独一份。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "花生的价值",
          "front_text": "能做什么？",
          "back_text": "种子含丰富脂肪与蛋白质，可制花生油、花生酱等零食；根部根瘤能固氮，兼可改良土壤肥力。",
          "citation_anchor": "固氮改土",
          "action_hint": "翻面看用途。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "花生要点",
          "streaming_content": "① 豆科落花生属一年生草本。\n② 约16世纪引种至中国。\n③ 重要油料与经济作物。",
          "citation_anchor": "16世纪入华",
          "action_hint": "平民坚果。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "花生",
        "url": "https://baike.baidu.com/item/%E8%8A%B1%E7%94%9F",
        "publish_date": "",
        "authority_level": "encyclopedia"
      }
    },
    {
      "id": "agriculture_topic_向日葵",
      "title": "向日葵",
      "tags": [
        "油料作物",
        "菊科"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "向日葵为什么追太阳？",
          "content": "向日葵（Helianthus annuus）未成熟花蕾具向日性追踪太阳，成熟后花头固定朝东不再随日转动；原产北美。",
          "citation_anchor": "向日性",
          "action_hint": "成熟后不再转。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "向日葵的用途",
          "front_text": "能做什么？",
          "back_text": "种子（葵花籽）可生食或烤制，榨取的葵花籽油作烹饪油；亦为常见观赏植物；2020年产量达5000万吨。",
          "citation_anchor": "葵花籽油",
          "action_hint": "翻面看产业。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "向日葵要点",
          "streaming_content": "① 菊科向日葵属大型一年生。\n② 可吸收铅、砷、铀等重金属（生态修复）。\n③ 多国文化国花或艺术象征。",
          "citation_anchor": "生态修复",
          "action_hint": "油赏兼修。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "向日葵",
        "url": "https://baike.baidu.com/item/%E5%90%91%E6%97%A5%E8%91%B5",
        "publish_date": "",
        "authority_level": "encyclopedia"
      }
    },
    {
      "id": "agriculture_topic_香蕉",
      "title": "香蕉",
      "tags": [
        "水果",
        "热带"
      ],
      "type": "knowledge",
      "sub_cards": [
        {
          "sub_id": "s1",
          "layout": "qa_card",
          "title": "香蕉是什么植物？",
          "content": "香蕉是芭蕉科芭蕉属小果野蕉与野蕉杂交的栽培种，泛指广泛栽种于热带、亚热带的多年生草本植物，假茎高2–3米。",
          "citation_anchor": "杂交栽培种",
          "action_hint": "最大草本植物之一。"
        },
        {
          "sub_id": "s2",
          "layout": "flip_card",
          "title": "香蕉的价值",
          "front_text": "为何重要？",
          "back_text": "果实富含淀粉，多可生食或烹饪；为全球重要的热带、亚热带经济栽培果树，世界上单体体型最大的草本植物之一。",
          "citation_anchor": "热带经济果",
          "action_hint": "翻面看价值。"
        },
        {
          "sub_id": "s3",
          "layout": "streaming_text",
          "title": "香蕉要点",
          "streaming_content": "① 学名 Musa × paradisiaca。\n② 地上部分由地下块茎生出。\n③ 全球重要热带果树。",
          "citation_anchor": "块茎生茎",
          "action_hint": "热带主食水果。"
        }
      ],
      "source": {
        "name": "百度百科",
        "title": "香蕉",
        "url": "https://baike.baidu.com/item/%E9%A6%99%E8%95%89",
